{
  "name": "LaTeX (abnTeX2)",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      // Pin a specific CTAN mirror if mirror.ctan.org redirects are flaky.
      "TL_MIRROR": "https://mirror.ctan.org/systems/texlive/tlnet"
    }
  },
  // Point latexindent at the repo's latexindent.yaml (runs in the workspace folder)
  "postCreateCommand": "printf 'paths:\\n  - %s/latexindent.yaml\\n' \"$PWD\" > ~/.indentconfig.yaml",
  "remoteUser": "vscode",
  "remoteEnv": {
    // Used by `texpkg` to record packages installed so they survive rebuilds.
    "TEX_PACKAGES_FILE": "${containerWorkspaceFolder}/.devcontainer/latex/tex-packages.txt"
  },
  "mounts": [
    // Keeps extensions (and LTeX+'s ~200 MB language server download) across rebuilds.
    "source=latex-devcontainer-extensions,target=/home/vscode/.vscode-server/extensions,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "James-Yu.latex-workshop",
        "ltex-plus.vscode-ltex-plus"
      ],
      "settings": {
        // --- Build: latexmk (pdfLaTeX + BibTeX). Project defaults live in .latexmkrc;
        //     the flags below repeat them so a .tex file in a subfolder builds the same way.
        "latex-workshop.latex.tools": [
          {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
              "-pdf",
              "-synctex=1",
              "-interaction=nonstopmode",
              "-file-line-error",
              "-outdir=%OUTDIR%",
              "%DOC%"
            ]
          }
        ],
        "latex-workshop.latex.recipes": [
          {
            "name": "latexmk (pdfLaTeX + BibTeX)",
            "tools": [
              "latexmk"
            ]
          }
        ],
        "latex-workshop.latex.recipe.default": "first",
        "latex-workshop.latex.outDir": "%DIR%/build",
        "latex-workshop.latex.autoBuild.run": "onSave",
        "latex-workshop.latex.autoClean.run": "never",
        "latex-workshop.view.pdf.viewer": "tab",
        "latex-workshop.formatting.latex": "latexindent",
        "latex-workshop.formatting.latexindent.args": [
          "-c",
          "%DIR%/",
          "%TMPFILE%",
          "-m",
          "-y=defaultIndent: '%INDENT%'"
        ],
        // --- Spell/grammar: LTeX+ (LanguageTool, bundled Java, runs offline) ---
        // Override per file with a magic comment near the top, e.g.:  % LTeX: language=en-US
        "ltex.language": "pt-BR",
        // abntex2cite citation commands: don't spell-check the citation keys
        "ltex.latex.commands": {
          "\\en{}": "dummy",
          "\\textsuperscript{}": "ignore",
          "\\citeonline{}": "dummy",
          "\\citeonline[]{}": "dummy",
          "\\citeonline[][]{}": "dummy",
          "\\apud{}{}": "dummy",
          "\\apud[]{}{}": "dummy",
          "\\makepagestyle{}": "ignore",
          "\\makeevenhead{}{}{}{}": "ignore",
          "\\makeoddhead{}{}{}{}": "ignore",
          "\\makeheadrule{}{}{}": "ignore",
          "\\aliaspagestyle{}{}": "ignore",
          "\\pagestyle{}": "ignore"
        },
        "[latex]": {
          "editor.wordWrap": "on",
          "editor.tabSize": 2,
          "editor.formatOnSave": true,
          "editor.insertSpaces": true
        },
        "files.eol": "\n",
        "files.encoding": "utf8"
      }
    }
  }
}
